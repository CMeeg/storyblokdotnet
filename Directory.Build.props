<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AnalysisLevel>10.0-recommended</AnalysisLevel>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Chris Meagher</Authors>
		<Copyright>Copyright © Chris Meagher 2026</Copyright>
		<PackageProjectUrl>https://github.com/CMeeg/storyblokdotnet</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/CMeeg/storyblokdotnet.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>https://github.com/CMeeg/storyblokdotnet/releases</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

</Project>
